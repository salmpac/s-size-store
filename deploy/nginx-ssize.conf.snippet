# s-size. The app is mounted at /s-size and builds its own absolute paths, so
# the prefix is passed through rather than stripped (no trailing slash on
# proxy_pass).

# Paths here are stable while their contents change (a real photo replacing a
# placeholder, a CSS edit), so the browser must revalidate rather than hold a
# copy for a fixed period. nginx answers an unchanged file with a 304.
# A long immutable max-age becomes correct once filenames carry a content hash.
location /s-size/static/ {
    alias /usr/share/ssize/static/;
    add_header Cache-Control "no-cache";
    access_log off;
}

location /s-size/media/ {
    alias /var/lib/ssize/media/;
    add_header Cache-Control "no-cache";
    access_log off;
}

location /s-size/ {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host              \$host;
    proxy_set_header X-Real-IP         \$remote_addr;
    proxy_set_header X-Forwarded-For   \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection        "";
    proxy_read_timeout 60s;
}
