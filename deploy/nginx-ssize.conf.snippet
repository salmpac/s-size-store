# Drop into the server block of salmpac.ru.
#
# nginx serves static files and images itself: it does sendfile and caching far
# better than the application would, and it keeps image bytes out of the
# process entirely. Only real requests reach the C++ server.

location /s-size/static/ {
    alias /usr/share/ssize/static/;
    expires 7d;
    add_header Cache-Control "public, immutable";
    access_log off;
}

location /s-size/media/ {
    alias /var/lib/ssize/media/;
    expires 30d;
    add_header Cache-Control "public, immutable";
    access_log off;
}

location /s-size/ {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;

    proxy_set_header Host              $host;
    # The server hashes this for metrics; it trusts the header because only
    # this proxy can reach the port.
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection        "";

    # Outbound redirects must never be cached anywhere along the path, or
    # repeat clicks stop being counted.
    proxy_no_cache      $upstream_http_cache_control;
    proxy_cache_bypass  $upstream_http_cache_control;
}
